# Placeholders only. Never commit real values.
# Aliases (read when nuxt.config.ts is evaluated, i.e. at build/dev start):
#   NUXT_PUBLIC_API_BASE <- API_BASE
#   NITRO_PRESET <- SERVER_PRESET
#   NUXT_ADMIN_SESSION_SECRET <- NUXT_SESSION_SECRET, ADMIN_SESSION_SECRET
#   NUXT_COOKIE_SECURE <- COOKIE_SECURE
#   NUXT_PUBLIC_VAPID_PUBLIC_KEY <- VAPID_PUBLIC_KEY
# Only the NUXT_* names override runtimeConfig in a built server at runtime.
NUXT_PUBLIC_API_BASE=https://api.bradobrey.uz
NITRO_PRESET=node-server
HOST=0.0.0.0
PORT=3000
NUXT_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Optional override. Leave unset to derive Secure from the request protocol.
# NUXT_COOKIE_SECURE=
NUXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-web-push-vapid-public-key
# Optional build flag. true bundles the full server dependency list from
# nuxt.config.ts into the Nitro output instead of tracing them as externals;
# unset/false inlines only @vue/shared.
# NITRO_INLINE_SERVER_DEPS=false
